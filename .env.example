# Configuracion del Servidor MCP para Kubernetes y Observabilidad

# Modo de ejecucion: 'live' (conecta a clusters y endpoints reales) o 'mock' (simulacion sintetica para pruebas)
MCP_MODE=mock

# Endpoints de Observabilidad
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# Configuracion de Kubernetes (requerido solo en modo 'live')
# Dejar vacio para usar configuracion in-cluster o ~/.kube/config
KUBECONFIG=

# Puerto para modo SSE (opcional, por defecto se usa transporte stdio)
MCP_PORT=8000
MCP_HOST=0.0.0.0
